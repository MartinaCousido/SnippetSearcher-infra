{
    "name": "snippetsearcher-newrelic",
    "private": true,
    "main": "index.ts",
    "scripts": {
        "pulumi": "node --env-file=.env node_modules/pulumi/run.js",
        "init": "npm run pulumi -- stack select --create snippetsearcher",
        "preview": "npm run pulumi -- preview",
        "up": "npm run pulumi -- up",
        "refresh": "npm run pulumi -- refresh",
        "destroy": "npm run pulumi -- destroy",
        "outputs": "npm run pulumi -- stack output"
    },
    "dependencies": {
        "@pulumi/newrelic": "5.80.3",
        "@pulumi/pulumi": "^3.272.0"
    },
    "devDependencies": {
        "@types/node": "^22.20.5",
        "pulumi": "3.272.0",
        "typescript": "^5.9.3"
    }
}
