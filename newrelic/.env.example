# Copiar a .env (que no se commitea) y completar. Ver "New Relic" en el README.
# INGEST - LICENSE: la usan los agentes para mandar datos.
NEW_RELIC_LICENSE_KEY=
# User key "pulumi": la usa Pulumi para crear synthetics, alertas y dashboard.
NEW_RELIC_API_KEY=
# Cuenta de New Relic (no es secreto) y región.
NEW_RELIC_ACCOUNT_ID=8714520
NEW_RELIC_REGION=US
# Mail al que llegan las alertas. No se commitea: el repo es público.
ALERT_EMAIL=
# Cifra los secretos del estado de Pulumi. Guardarla: todos los comandos la piden.
PULUMI_CONFIG_PASSPHRASE=
# App de Auth0 de los synthetics (sale de auth0/: npm run outputs).
SYNTHETICS_CLIENT_ID=
SYNTHETICS_CLIENT_SECRET=
