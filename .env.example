# Variables que pide docker-stack.yml. Sirve solo para probar en local:
#   cp .env.example .env
#   set -a; source .env; set +a
#   docker stack config -c docker-stack.yml
#
# En las VMs no se usa este archivo: las variables las pone el workflow de CD,
# desde los secrets de cada Environment de GitHub. El .env no se commitea.
TAG=dev
SNIPPETS_DB_PASSWORD=cambiar-en-local
PERMISOS_DB_PASSWORD=cambiar-en-local
