# Copiar a auth0/.env y completar. El .env no se commitea (el repo es público).
# Los scripts de npm (npm run up, etc.) lo leen antes de correr Pulumi.

# Dominio del tenant, sin https://
AUTH0_DOMAIN=dev-eadjutr73y1lgdc5.us.auth0.com

# Credenciales de la app Machine to Machine "pulumi" (Applications → pulumi →
# Settings). El proveedor de Auth0 de Pulumi lee estos nombres exactos.
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Contraseña de los usuarios de prueba. Política de Auth0 por defecto: 8 o más
# caracteres, con minúsculas, mayúsculas y números.
USUARIOS_PASSWORD=

# Cifra los secretos dentro del estado de Pulumi (auth0/.pulumi/). Puede ser
# cualquier texto, pero hay que guardarlo: todos los comandos piden el mismo.
PULUMI_CONFIG_PASSPHRASE=
